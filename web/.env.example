# From your Supabase project: Project Settings > API
# https://supabase.com/dashboard/project/_/settings/api

# Safe to expose in the browser — access is governed by RLS, not by keeping
# this secret. See supabase/SETUP.md step 7.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# NEVER prefix this with NEXT_PUBLIC_ and never reference it from a Client
# Component — it bypasses RLS entirely. Server-only code (route handlers,
# server actions, scripts) only.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From resend.com/api-keys. Server-only (read in lib/email/send-template-email.ts,
# a "use server" action, never sent to the browser). Without this set, sending
# a template email fails with a clear "no email provider configured" error
# instead of silently doing nothing.
# RESEND_API_KEY=your-resend-api-key

# Must be on a domain verified in Resend (Domains tab), or sending fails for
# any recipient outside your own Resend account. Falls back to Resend's
# shared onboarding@resend.dev address, which only delivers to the email the
# Resend account itself was signed up with, fine for testing, not for
# sending to real contacts.
# RESEND_FROM_EMAIL=noreply@covison.com
