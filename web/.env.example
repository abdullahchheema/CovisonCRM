# From your Supabase project: Project Settings > API
# https://supabase.com/dashboard/project/_/settings/api

# Safe to expose in the browser — access is governed by RLS, not by keeping
# this secret. See supabase/SETUP.md step 7.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# NEVER prefix this with NEXT_PUBLIC_ and never reference it from a Client
# Component — it bypasses RLS entirely. Server-only code (route handlers,
# server actions, scripts) only.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
