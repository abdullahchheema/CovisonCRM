# MySQL DSN — create the database first: CREATE DATABASE tinycrm;
# clientFoundRows=true is required so updates that don't change any values still
# report a matched row (MySQL otherwise returns 0 affected rows for no-op updates).
DB_CONNECT=root:yourpassword@tcp(127.0.0.1:3306)/tinycrm?parseTime=true&charset=utf8mb4&loc=Local&clientFoundRows=true

# SMTP credentials for sending emails
EMAIL_ID=you@example.com
EMAIL_PWD=your-app-password

# Secrets — generate with: openssl rand -hex 32
TOKEN_SECRET=change-me-to-a-random-secret
CRYPTR_SECRET=change-me-to-a-random-secret

# Public URL of the frontend (used in email verification links)
FRONTEND_LINK=http://localhost/

# Port the Go server listens on (default 4050)
# PORT=4050
